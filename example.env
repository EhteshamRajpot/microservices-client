# Copy to `.env` or `.env.local` and restart `npm run dev`.
# Stripe Dashboard → Developers → API keys → Publishable key (test mode).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# SSR (Next server → API). Usually unset locally; Next rewrites /api to NEXT_PUBLIC_API_URL / API_PROXY_TARGET.
# In Kubernetes, set on the client Deployment if https://ticketing.dev does not resolve from the pod:
# SERVER_SIDE_API_URL=https://ticketing.dev
# Or reach ingress inside the cluster (your real Service DNS):
# INTERNAL_INGRESS_URL=http://ingress-nginx-controller.ingress-nginx.svc.cluster.local
